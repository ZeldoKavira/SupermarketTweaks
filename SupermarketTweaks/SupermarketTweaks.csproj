<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SupermarketTweaks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- The game ships its own Unity/Mono assemblies; never copy them next to the plugin. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0436;CS8632</NoWarn>

    <!-- Overridden by CI from the git tag: -p:Version=1.4.0. The default keeps local builds
         honest about being untagged rather than claiming to be a release. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Supermarket Together</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Supermarket Together_Data\Managed</ManagedDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
    <Managed>$(ManagedDir)</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath></Reference>

    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath></Reference>

    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)\UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath></Reference>

    <Reference Include="Mirror"><HintPath>$(Managed)\Mirror.dll</HintPath></Reference>

    <!-- Needed to clone the game's own UI button: Button and Image live in UnityEngine.UI, and the
         RectTransform/Canvas types they depend on live in UIModule. -->
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)"><Private>false</Private></Reference>
  </ItemGroup>

  <!-- BepInPlugin needs a compile-time constant, so the version is written into a generated
       source file rather than read at runtime. WriteOnlyWhenDifferent keeps this from dirtying
       the build every time. -->
  <Target Name="GeneratePluginVersion" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <PluginVersionFile>$(IntermediateOutputPath)PluginVersion.cs</PluginVersionFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(PluginVersionFile)"
      Lines="namespace SupermarketTweaks { internal static class PluginVersion { internal const string Value = &quot;$(Version)&quot;%3B } }"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(PluginVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
